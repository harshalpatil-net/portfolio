    <script>
        // BACKGROUND NETWORK ANIMATION
        const canvas = document.getElementById('canvas-nodes');
        const ctx = canvas.getContext('2d');
        let width = canvas.width = window.innerWidth;
        let height = canvas.height = window.innerHeight;

        window.addEventListener('resize', () => {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        });

        const nodes = [];
        const nodeCount = 45;

        for (let i = 0; i < nodeCount; i++) {
            nodes.push({
                x: Math.random() * width,
                y: Math.random() * height,
                vx: (Math.random() - 0.5) * 0.8,
                vy: (Math.random() - 0.5) * 0.8,
                radius: 2
            });
        }

        function drawNodes() {
            ctx.clearRect(0, 0, width, height);
            
            ctx.fillStyle = '#00ff66';
            ctx.strokeStyle = 'rgba(0, 240, 255, 0.15)';

            for (let i = 0; i < nodes.length; i++) {
                let nodeA = nodes[i];
                nodeA.x += nodeA.vx;
                nodeA.y += nodeA.vy;

                if (nodeA.x < 0 || nodeA.x > width) nodeA.vx *= -1;
                if (nodeA.y < 0 || nodeA.y > height) nodeA.vy *= -1;

                ctx.beginPath();
                ctx.arc(nodeA.x, nodeA.y, nodeA.radius, 0, Math.PI * 2);
                ctx.fill();

                for (let j = i + 1; j < nodes.length; j++) {
                    let nodeB = nodes[j];
                    let dist = Math.hypot(nodeA.x - nodeB.x, nodeA.y - nodeB.y);
                    if (dist < 120) {
                        ctx.beginPath();
                        ctx.moveTo(nodeA.x, nodeA.y);
                        ctx.lineTo(nodeB.x, nodeB.y);
                        ctx.stroke();
                    }
                }
            }
            requestAnimationFrame(drawNodes);
        }
        drawNodes();

        // CLI TERMINAL INTERACTION
        const cliInput = document.getElementById('cli-input');
        const termBody = document.getElementById('terminal-body');

        const commands = {
            'help': 'Available commands:\n- about : Brief introduction\n- skills : Technical stack\n- whoami : User profile info\n- clear : Clear terminal screen',
            'about': 'Harshal Patil | BCA Student & Network Engineer enthusiastic about Routing, Switching & Security.',
            'skills': 'Protocols: OSPF, BGP, VLAN, STP, TCP/IP\nTools: Cisco Packet Tracer, Wireshark, GNS3, Linux',
            'whoami': 'Guest User @ harshal.net (Privilege Level 1)',
            'clear': 'CLEAR'
        };

        cliInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                const val = cliInput.value.trim().toLowerCase();
                const cmdLine = document.createElement('div');
                cmdLine.className = 'output';
                cmdLine.innerHTML = `<span style="color:var(--accent-green)">guest@harshal.net:~$</span> ${cliInput.value}`;
                
                termBody.insertBefore(cmdLine, cliInput.parentElement);

                if (val in commands) {
                    if (commands[val] === 'CLEAR') {
                        termBody.innerHTML = '';
                        termBody.appendChild(cliInput.parentElement);
                    } else {
                        const res = document.createElement('div');
                        res.className = 'output';
                        res.style.color = '#00f0ff';
                        res.innerText = commands[val];
                        termBody.insertBefore(res, cliInput.parentElement);
                    }
                } else if (val !== '') {
                    const err = document.createElement('div');
                    err.className = 'output';
                    err.style.color = '#ff5f56';
                    err.innerText = `Command not found: ${val}. Type 'help' for options.`;
                    termBody.insertBefore(err, cliInput.parentElement);
                }

                cliInput.value = '';
                termBody.scrollTop = termBody.scrollHeight;
            }
        });

        // SUBNET CALCULATOR JS
        const cidrSlider = document.getElementById('cidr-val');
        const cidrNum = document.getElementById('cidr-num');

        cidrSlider.addEventListener('input', () => {
            cidrNum.innerText = cidrSlider.value;
            calculateSubnet();
        });

        function calculateSubnet() {
            const ip = document.getElementById('ip-addr').value.trim();
            const cidr = parseInt(cidrSlider.value);
            
            const ipParts = ip.split('.').map(Number);
            if (ipParts.length !== 4 || ipParts.some(p => isNaN(p) || p < 0 || p > 255)) {
                alert('Please enter a valid IPv4 address.');
                return;
            }

            const maskBinary = '1'.repeat(cidr) + '0'.repeat(32 - cidr);
            const maskParts = [
                parseInt(maskBinary.substring(0, 8), 2),
                parseInt(maskBinary.substring(8, 16), 2),
                parseInt(maskBinary.substring(16, 24), 2),
                parseInt(maskBinary.substring(24, 32), 2)
            ];

            const netParts = ipParts.map((part, i) => part & maskParts[i]);
            const broadcastParts = ipParts.map((part, i) => part | (~maskParts[i] & 255));

            const totalHosts = Math.pow(2, 32 - cidr) - 2;

            document.getElementById('res-mask').innerText = maskParts.join('.');
            document.getElementById('res-net').innerText = netParts.join('.');
            document.getElementById('res-bc').innerText = broadcastParts.join('.');
            
            const firstHost = [...netParts]; firstHost[3] += 1;
            const lastHost = [...broadcastParts]; lastHost[3] -= 1;
            
            document.getElementById('res-range').innerText = `${firstHost.join('.')} - ${lastHost.join('.')}`;
            document.getElementById('res-hosts').innerText = totalHosts > 0 ? totalHosts.toLocaleString() : 0;
        }
    </script>
</body>
</html>
